{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zerovault",
  "version": "0.1.0",
  "identifier": "rs.entropy.cloud.zerovault",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "tray_popup",
        "title": "Zerovault Tray",
        "width": 380,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="..\..\target\swarm\bakeoff-ui-dotnet\nuget-packages" />
  </config>
  <fallbackPackageFolders>
    <add key="HostNuGetCache" value="C:\Users\User\.nuget\packages" />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

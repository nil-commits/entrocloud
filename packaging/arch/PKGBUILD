# Maintainer: cloud.entropy.rs <ops@cloud.entropy.rs>
pkgname=entrocloud
pkgver=1.0.1
pkgrel=1
pkgdesc="Zero-knowledge multi-cloud encrypted virtual filesystem and automatic folder backup suite (daemon, CLI, pure-Rust GPU UI, and tray helper)"
arch=('x86_64' 'aarch64')
url="https://cloud.entropy.rs/entrocloud"
license=('MIT' 'Apache-2.0')
depends=(
  'dbus'
  'fuse3'
  'gcc-libs'
  'glibc'
  'libglvnd'
  'libxkbcommon'
  'wayland'
)
makedepends=(
  'cargo'
  'cmake'
)
optdepends=(
  'attr: getfattr and setfattr utilities for FUSE3 extended attribute pinning'
  'gnome-keyring: persistent Secret Service credential storage (or kwallet)'
  'libx11: X11 display backend support for the desktop UI'
  'xdg-desktop-portal: native desktop file and folder picker dialogs'
  'xdg-utils: open OAuth2 sign-in URLs in the default desktop browser'
)
source=(
  'entrocloudd.service'
  'entrocloud-tray.service'
  'entrocloud.desktop'
  'entrocloud.svg'
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

_resolve_workspace_root() {
  if [[ -f "${srcdir}/${pkgname}-${pkgver}/Cargo.toml" ]]; then
    printf '%s\n' "${srcdir}/${pkgname}-${pkgver}"
  else
    (cd "${startdir}/../.." && pwd)
  fi
}

prepare() {
  local ws_root
  ws_root="$(_resolve_workspace_root)"
  cd "${ws_root}"
  export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  local ws_root
  ws_root="$(_resolve_workspace_root)"
  cd "${ws_root}"
  export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo build --release --locked \
    -p entrocloud-daemon \
    -p entrocloud-cli \
    -p entrocloud-ui
}

package() {
  local ws_root target_dir
  ws_root="$(_resolve_workspace_root)"
  target_dir="${ws_root}/${CARGO_TARGET_DIR:-target}/release"
  if [[ "${CARGO_TARGET_DIR:-}" == /* ]]; then
    target_dir="${CARGO_TARGET_DIR}/release"
  fi

  install -Dm755 "${target_dir}/entrocloudd" "${pkgdir}/usr/bin/entrocloudd"
  install -Dm755 "${target_dir}/ec" "${pkgdir}/usr/bin/ec"
  install -Dm755 "${target_dir}/entrocloud" "${pkgdir}/usr/bin/entrocloud"
  install -Dm755 "${target_dir}/entrocloud-tray" "${pkgdir}/usr/bin/entrocloud-tray"

  install -Dm644 "${srcdir}/entrocloudd.service" \
    "${pkgdir}/usr/lib/systemd/user/entrocloudd.service"
  install -Dm644 "${srcdir}/entrocloud-tray.service" \
    "${pkgdir}/usr/lib/systemd/user/entrocloud-tray.service"
  install -Dm644 "${srcdir}/entrocloud.desktop" \
    "${pkgdir}/usr/share/applications/entrocloud.desktop"
  install -Dm644 "${srcdir}/entrocloud.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/entrocloud.svg"

  if [[ -f "${ws_root}/crates/entrocloud-ui/icons/32x32.png" ]]; then
    install -Dm644 "${ws_root}/crates/entrocloud-ui/icons/32x32.png" \
      "${pkgdir}/usr/share/icons/hicolor/32x32/apps/entrocloud.png"
  fi
  if [[ -f "${ws_root}/crates/entrocloud-ui/icons/128x128.png" ]]; then
    install -Dm644 "${ws_root}/crates/entrocloud-ui/icons/128x128.png" \
      "${pkgdir}/usr/share/icons/hicolor/128x128/apps/entrocloud.png"
  fi

  if [[ -f "${ws_root}/README.md" ]]; then
    install -Dm644 "${ws_root}/README.md" \
      "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  fi
  if [[ -f "${ws_root}/GOOGLE-DRIVE-SETUP.md" ]]; then
    install -Dm644 "${ws_root}/GOOGLE-DRIVE-SETUP.md" \
      "${pkgdir}/usr/share/doc/${pkgname}/GOOGLE-DRIVE-SETUP.md"
  fi
  if [[ -f "${ws_root}/SPEC_CRYPTO.md" ]]; then
    install -Dm644 "${ws_root}/SPEC_CRYPTO.md" \
      "${pkgdir}/usr/share/doc/${pkgname}/SPEC_CRYPTO.md"
  fi
}

[Unit]
Description=Zerovault Zero-Knowledge Multi-Cloud Sync Daemon
Documentation=https://cloud.entropy.rs/zerovault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zerovaultd
Restart=on-failure
RestartSec=3s
Environment=RUST_LOG=info

# Resource & privilege hardening
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=default.target

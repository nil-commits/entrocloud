[Unit]
Description=EntroCloud Zero-Knowledge Multi-Cloud Sync, Backup & FUSE3 Daemon
Documentation=https://cloud.entropy.rs/entrocloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/entrocloudd
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
Environment=RUST_LOG=info

# Pre-create owner-only runtime ($XDG_RUNTIME_DIR/entrocloud) and config directories
ConfigurationDirectory=entrocloud
ConfigurationDirectoryMode=0700
RuntimeDirectory=entrocloud
RuntimeDirectoryMode=0700
UMask=0077

# Resource & process hardening
# Note: NoNewPrivileges and RestrictSUIDSGID are intentionally omitted so unprivileged
# FUSE3 mounts can invoke setuid /usr/bin/fusermount3.
MemoryHigh=256M
MemoryMax=512M
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target

[Unit]
Description=EntroCloud Lightweight System Tray Helper (0 B Closed-Window UI RAM)
Documentation=https://cloud.entropy.rs/entrocloud
PartOf=graphical-session.target
After=graphical-session.target entrocloudd.service
Wants=entrocloudd.service

[Service]
Type=simple
ExecStart=/usr/bin/entrocloud-tray
Restart=on-failure
RestartSec=3s
Environment=RUST_LOG=info
UMask=0077

# Process hardening
# Note: MemoryDenyWriteExecute is intentionally omitted because spawning the
# on-demand GPU UI (entrocloud) requires Mesa/OpenGL shader JIT mappings.
LockPersonality=true

[Install]
WantedBy=graphical-session.target
